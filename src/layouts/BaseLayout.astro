---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import { ClientRouter } from "astro:transitions";
import { site } from "../data/site";

const {
  title = "NERDS - Núcleo de Software",
  description = "NERDS - Núcleo Especializado em Reengenharia e Desenvolvimento de Software. Conectando universidade e sociedade por meio da tecnologia.",
  canonical = Astro.url.href,
  ogType = "website",
} = Astro.props;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="NERDS - Núcleo de Software" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={new URL('/og-image.png', Astro.url.href)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.url.href)} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "NERDS - Núcleo de Software",
      "url": Astro.site?.toString() ?? site.url,
      "description": site.description,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Russas",
        "addressRegion": "CE",
        "addressCountry": "BR"
      },
      "sameAs": []
    })} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500&family=Fira+Code:wght@500&display=swap" rel="stylesheet">
    
    <link rel="icon" type="image/png" href="/favicon.png" />
    <ClientRouter />
  </head>
  <body>
    <div class="app-wrapper">
      <Header />
      <main class="container">
        <slot />
      </main>
      <Footer />
      <BackToTop />
    </div>
    <script src="../scripts/text-scramble.ts"></script>
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
