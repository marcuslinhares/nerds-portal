---
import { site } from "../data/site";
---

<footer class="glass">
  <div class="container footer-content">
    <div class="footer-grid">
      <div class="footer-info">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
          <img src="/favicon.png" alt="NERDS Logo" style="width: 32px; height: 32px; filter: drop-shadow(0 0 10px rgba(0, 219, 233, 0.3));" />
          <h3 class="mono" style="margin: 0;">{site.name.toUpperCase()}</h3>
        </div>
        <p>{site.description}</p>
      </div>
      
      <div class="footer-contact">
        <p class="mono-label">CONTACT_GATEWAY</p>
        <a href={`mailto:${site.email}`} class="email-link mono">{site.email}</a>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p class="mono-label">&copy; 2026 CYBER_ACADEMIC_NERDS // STATUS: OPERATIONAL</p>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: 3rem;
    border-top: 1px solid rgba(0, 219, 233, 0.1);
    padding: 1.5rem 0 1rem 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  h3 {
    margin: 0 0 1rem 0;
    font-size: 1rem;
    letter-spacing: 0.1em;
  }

  p {
    opacity: 0.7;
    font-size: 0.9rem;
    max-width: 400px;
  }

  .mono-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-secondary);
    margin-bottom: 0.5rem;
    opacity: 0.8;
  }

  .email-link {
    display: block;
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .email-link:hover {
    text-shadow: 0 0 10px var(--color-primary);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .footer-bottom p {
    margin: 0;
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
