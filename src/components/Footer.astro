---
import { site } from "../data/site";
---

<footer class="glass">
  <div class="container footer-content">
    <div class="footer-grid">
      <div class="footer-info">
        <h3 class="mono">{site.name.toUpperCase()}</h3>
        <p>{site.description}</p>
      </div>
      
      <div class="footer-contact">
        <p class="mono-label">CONTACT_GATEWAY</p>
        <a href={`mailto:${site.email}`} class="email-link mono">{site.email}</a>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p class="mono-label">&copy; 2026 CYBER_ACADEMIC_NERDS // STATUS: OPERATIONAL</p>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: 5rem;
    border-top: 1px solid rgba(0, 219, 233, 0.1);
    padding: 3rem 0 1.5rem 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  h3 {
    margin: 0 0 1rem 0;
    font-size: 1rem;
    letter-spacing: 0.1em;
  }

  p {
    opacity: 0.7;
    font-size: 0.9rem;
    max-width: 400px;
  }

  .mono-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-secondary);
    margin-bottom: 0.5rem;
    opacity: 0.8;
  }

  .email-link {
    display: block;
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .email-link:hover {
    text-shadow: 0 0 10px var(--color-primary);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 1.5rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
