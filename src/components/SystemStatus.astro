---
---
<div class="system-status mono">
  <div class="status-item">
    <span class="label">SYS_LOAD:</span>
    <span class="value" id="sys-load">24%</span>
  </div>
  <div class="status-item">
    <span class="label">UPTIME:</span>
    <span class="value" id="uptime">99.9%</span>
  </div>
  <div class="status-indicator">
    <span class="pulse"></span>
    OPERATIONAL
  </div>
</div>

<style>
  .system-status {
    position: absolute;
    top: 2px;
    right: 0;
    display: flex;
    gap: 1rem;
    font-size: 0.55rem;
    color: var(--color-text);
    opacity: 0.5;
    padding: 2px 10px;
    background: rgba(16, 19, 26, 0.4);
    border-bottom-left-radius: 4px;
    pointer-events: none;
    letter-spacing: 0.05em;
  }
  
  .label { color: var(--color-primary); }
  
  .status-indicator {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--color-secondary);
  }

  .pulse {
    width: 4px;
    height: 4px;
    background: var(--color-secondary);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.3; }
    100% { opacity: 1; }
  }

  @media (max-width: 768px) {
    .system-status { display: none; }
  }
</style>

<script>
  function updateMetrics() {
    const loadEl = document.getElementById('sys-load');
    if (loadEl) {
      const load = Math.floor(Math.random() * (35 - 15) + 15);
      loadEl.textContent = `${load}%`;
    }
  }
  setInterval(updateMetrics, 5000);
</script>
