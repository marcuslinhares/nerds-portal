---
import { site } from "../data/site";
import SystemStatus from "./SystemStatus.astro";

const normalizePath = (path: string) =>
  path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path;

const pathname = normalizePath(Astro.url.pathname);
---

<header class="glass">
  <div class="container header-content">
    <div class="header-top">
      <a href="/" class="logo mono">
        <span class="pulse"></span>
        {site.name.toUpperCase()}
      </a>
      <SystemStatus />
    </div>
    
    <nav aria-label="Navegacao principal" class="main-nav">
      <ul class="nav-links">
        {
          site.menu.map((item) => {
            const href = normalizePath(item.href);
            const isAvailable = site.availableRoutes.includes(href);
            const isCurrent = pathname === href;

            return (
              <li>
                {isAvailable ? (
                  <a 
                    href={item.href} 
                    aria-current={isCurrent ? "page" : undefined}
                    class={isCurrent ? "active" : ""}
                  >
                    {item.label}
                  </a>
                ) : (
                  <span class="disabled" title="Disponível em breve">
                    {item.label}
                  </span>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(0, 219, 233, 0.1);
    margin-bottom: 2rem;
  }

  .header-content {
    padding: 0.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
  }

  .pulse {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-primary);
    animation: glow-pulse 2s infinite;
  }

  @keyframes glow-pulse {
    0% { opacity: 0.4; }
    50% { opacity: 1; }
    100% { opacity: 0.4; }
  }

  .main-nav {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 0.5rem;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-links a, .nav-links .disabled {
    font-family: var(--font-body);
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--color-text);
    opacity: 0.7;
    transition: all 0.2s ease;
    padding: 0.5rem 0;
    border-bottom: 2px solid transparent;
  }

  .nav-links a:hover {
    opacity: 1;
    color: var(--color-primary);
  }

  .nav-links a.active {
    opacity: 1;
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
    text-shadow: 0 0 10px rgba(0, 219, 233, 0.3);
  }

  .disabled {
    cursor: not-allowed;
    opacity: 0.3 !important;
  }

  @media (max-width: 900px) {
    .nav-links {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      gap: 1rem;
    }
    .nav-links a {
      white-space: nowrap;
    }
  }
</style>
