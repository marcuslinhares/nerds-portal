---
import { site } from "../data/site";

const normalizePath = (path: string) =>
  path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path;

const pathname = normalizePath(Astro.url.pathname);
---

<header>
  <div class="container">
    <nav aria-label="Navegacao principal">
      <a href="/">{site.name}</a>
      <ul>
        {
          site.menu.map((item) => {
            const href = normalizePath(item.href);
            const isAvailable = site.availableRoutes.includes(href);
            const isCurrent = pathname === href;

            return (
              <li>
                {isAvailable ? (
                  <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
                    {item.label}
                  </a>
                ) : (
                  <span aria-disabled="true" title="Disponivel em breve">
                    {item.label}
                  </span>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
