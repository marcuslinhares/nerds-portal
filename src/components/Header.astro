---
import { site } from "../data/site";
import SystemStatus from "./SystemStatus.astro";

const normalizePath = (path: string) =>
  path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path;

const pathname = normalizePath(Astro.url.pathname);
---

<header class="glass">
  <div class="container header-content">
    <nav aria-label="Navegacao principal" class="main-nav">
      <a href="/" class="logo mono">
        <span class="pulse"></span>
        {site.name.toUpperCase()}
      </a>
      
      <!-- Desktop Nav -->
      <ul class="nav-links desktop-only">
        {
          site.menu.map((item) => {
            const href = normalizePath(item.href);
            const isAvailable = site.availableRoutes.includes(href);
            const isCurrent = pathname === href;

            return (
              <li>
                {isAvailable ? (
                  <a 
                    href={item.href} 
                    aria-current={isCurrent ? "page" : undefined}
                    class={isCurrent ? "active" : ""}
                  >
                    {item.label}
                  </a>
                ) : (
                  <span class="disabled" title="Disponível em breve">
                    {item.label}
                  </span>
                )}
              </li>
            );
          })
        }
      </ul>

      <!-- Mobile Toggle -->
      <button id="menu-toggle" class="menu-btn mobile-only mono" aria-label="Abrir menu">
        <span class="menu-icon"></span>
        MENU_
      </button>
    </nav>
    
    <SystemStatus />
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="mobile-drawer">
    <div class="drawer-header">
       <span class="mono" style="color: var(--color-primary); font-size: 0.8rem;">NAV_GATEWAY_V1.0</span>
       <button id="menu-close" class="close-btn mono">X_CLOSE</button>
    </div>
    <ul class="drawer-links">
      {
        site.menu.map((item) => {
          const href = normalizePath(item.href);
          const isAvailable = site.availableRoutes.includes(href);
          const isCurrent = pathname === href;

          return (
            <li>
              {isAvailable ? (
                <a 
                  href={item.href} 
                  class={`drawer-link mono ${isCurrent ? "active" : ""}`}
                >
                  <span class="arrow">></span> {item.label.toUpperCase()}
                </a>
              ) : (
                <span class="disabled mono">> {item.label.toUpperCase()}</span>
              )}
            </li>
          );
        })
      }
    </ul>
    <div class="drawer-footer">
       <p class="mono" style="font-size: 0.6rem; opacity: 0.5;">SECURE_CONNECTION: ACTIVE</p>
    </div>
  </div>
  <div id="drawer-overlay" class="drawer-overlay"></div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(0, 219, 233, 0.1);
    margin-bottom: 2rem;
  }

  .header-content {
    padding: 1.25rem 0;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .main-nav {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    flex-shrink: 0;
    z-index: 102;
  }

  .pulse {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-primary);
    animation: glow-pulse 2s infinite;
  }

  @keyframes glow-pulse {
    0% { opacity: 0.4; }
    50% { opacity: 1; }
    100% { opacity: 0.4; }
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-links a, .nav-links .disabled {
    font-family: var(--font-body);
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--color-text);
    opacity: 0.7;
    transition: all 0.2s ease;
    padding: 0.5rem 0;
    border-bottom: 2px solid transparent;
  }

  .nav-links a:hover {
    opacity: 1;
    color: var(--color-primary);
  }

  .nav-links a.active {
    opacity: 1;
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
    text-shadow: 0 0 10px rgba(0, 219, 233, 0.3);
  }

  .disabled {
    cursor: not-allowed;
    opacity: 0.3 !important;
  }

  /* Desktop vs Mobile Visibility (Scoped) */
  .menu-btn {
    display: none;
    background: transparent;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    padding: 6px 12px;
    font-size: 0.7rem;
    cursor: pointer;
    align-items: center;
    gap: 8px;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .desktop-nav {
    display: flex;
  }

  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .menu-btn { display: flex; }
    .mobile-drawer { display: flex; }
  }

  .menu-btn:hover {
    background: rgba(0, 219, 233, 0.1);
    box-shadow: 0 0 10px rgba(0, 219, 233, 0.2);
  }

  .menu-icon {
    width: 12px;
    height: 1px;
    background: var(--color-primary);
    position: relative;
  }
  .menu-icon::before, .menu-icon::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 1px;
    background: var(--color-primary);
    left: 0;
  }
  .menu-icon::before { top: -4px; }
  .menu-icon::after { top: 4px; }

  /* Drawer Styles */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: -100%;
    width: 80%;
    max-width: 300px;
    height: 100vh;
    background: rgba(16, 19, 26, 0.98);
    backdrop-filter: blur(25px);
    z-index: 1000;
    transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 2.5rem;
    border-left: 1px solid var(--color-primary);
    display: flex;
    flex-direction: column;
    visibility: hidden; /* Garantir que comece invisível */
  }

  .mobile-drawer.open {
    right: 0;
    visibility: visible;
    box-shadow: -10px 0 50px rgba(0, 0, 0, 0.8);
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4rem;
  }

  .close-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text);
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.65rem;
    transition: all 0.2s ease;
  }

  .close-btn:hover {
    background: rgba(255, 0, 0, 0.1);
    border-color: #ff3e3e;
    color: #ff3e3e;
  }

  .drawer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .drawer-link {
    text-decoration: none;
    color: var(--color-text) !important; /* Forçar cor do texto */
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: all 0.3s ease;
  }

  .drawer-link .arrow {
    color: var(--color-primary);
    opacity: 0.4;
    font-weight: bold;
  }

  .drawer-link:hover {
    color: var(--color-primary) !important;
    transform: translateX(8px);
  }

  .drawer-link.active {
    color: var(--color-primary) !important;
    text-shadow: 0 0 15px var(--color-primary);
  }

  .drawer-footer {
    margin-top: auto;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease;
  }

  .drawer-overlay.open {
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  function initMenu() {
    const toggle = document.getElementById('menu-toggle');
    const close = document.getElementById('menu-close');
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('drawer-overlay');
    const links = document.querySelectorAll('.drawer-link');

    function toggleMenu(open: boolean) {
      if (open) {
        drawer?.classList.add('open');
        overlay?.classList.add('open');
        document.body.style.overflow = 'hidden';
      } else {
        drawer?.classList.remove('open');
        overlay?.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    toggle?.addEventListener('click', () => toggleMenu(true));
    close?.addEventListener('click', () => toggleMenu(false));
    overlay?.addEventListener('click', () => toggleMenu(false));

    // Fecha ao clicar em um link (importante para ClientRouter)
    links.forEach(link => {
      link.addEventListener('click', () => toggleMenu(false));
    });
  }

  document.addEventListener('astro:page-load', initMenu);
  if (document.readyState === 'complete') {
    initMenu();
  } else {
    window.addEventListener('load', initMenu);
  }
</script>
}
</script>

</script>
