---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { cursos } from "../../data/cursos";

export function getStaticPaths() {
  return cursos.map((c) => ({
    params: { slug: c.slug },
    props: { c },
  }));
}

const { c } = Astro.props;
---

<BaseLayout title={`${c.titulo} | Cursos`} description={`Ementa do curso ${c.titulo}`}>
  <article>
    <a href="/cursos" class="mono" style="color: var(--color-secondary); text-decoration: none; font-size: 0.8rem; display: block; margin-bottom: 1rem;">
      &lt; VOLTAR PARA CATÁLOGO
    </a>

    <SectionTitle title={c.titulo} subtitle={`Carga Horária: ${c.cargaHoraria} | Status: ${c.status}`} />

    <div class="glass" style="padding: 2.5rem; margin-top: 2rem;">
      <h3 class="mono" style="color: var(--color-primary); margin-bottom: 2rem;">EMENTA TÉCNICA DO MÓDULO</h3>
      <div class="ementa-list">
        {c.ementa.map((item, index) => (
          <div class="ementa-item">
            <span class="mono" style="color: var(--color-secondary); min-width: 40px;">0{index + 1}</span>
            <p style="margin: 0;">{item}</p>
          </div>
        ))}
      </div>
      
      <div style="margin-top: 3rem; border-top: 1px solid var(--color-outline); padding-top: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <p class="mono" style="font-size: 0.9rem; margin: 0;">CERTIFICAÇÃO ACADÊMICA INCLUÍDA</p>
        <button class="enroll-btn mono">EFETUAR INSCRIÇÃO</button>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .ementa-list {
    display: grid;
    gap: 1.5rem;
  }
  .ementa-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-sm);
  }
  .enroll-btn {
    background: transparent;
    border: 1px solid var(--color-secondary);
    color: var(--color-secondary);
    padding: 1rem 2rem;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 0.3s ease;
  }
  .enroll-btn:hover {
    background: var(--color-secondary);
    color: var(--color-bg);
    box-shadow: 0 0 15px var(--color-secondary);
  }
</style>
