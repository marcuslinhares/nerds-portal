---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout
  title="Inicio | Extensao Universitaria"
  description="Conectando universidade e sociedade por meio de projetos, cursos e atividades."
>
  <!-- Hero Section -->
  <section class="hero">
    <h1>Extensao <span class="glow">Universitaria</span></h1>
    <p class="mono">> Conectando universidade e sociedade por meio de tecnologia e inovação.</p>
  </section>

  <!-- Highlights Section -->
  <section>
    <SectionTitle title="Destaques" subtitle="Iniciativas em evidência no portal" />
    <div class="grid">
      <article class="card glass">
        <h3>Projetos</h3>
        <p>Ações contínuas de impacto social.</p>
      </article>
      <article class="card glass">
        <h3>Cursos</h3>
        <p>Capacitação e formação para a comunidade.</p>
      </article>
      <article class="card glass">
        <h3>Notícias</h3>
        <p>Últimos eventos e atualizações.</p>
      </article>
    </div>
  </section>

  <!-- Participation Section -->
  <section class="glass" style="margin-top: 4rem; padding: 2rem;">
    <SectionTitle title="Como Participar" />
    <p>
      Fique atento aos editais abertos e inscreva-se nas nossas atividades. A extensão é o espaço
      de troca entre o saber acadêmico e a prática social.
    </p>
  </section>

  <!-- Partners Section -->
  <section style="margin-top: 4rem;">
    <SectionTitle title="Parceiros" subtitle="Instituições que apoiam nossa missão" />
    <div class="partners-placeholder">
      <p class="mono">[ Conexão com parceiros institucionais via API/Data ]</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 0;
    text-align: center;
  }
  h1 {
    font-size: 3.5rem;
    margin: 0;
  }
  .glow {
    text-shadow: 0 0 15px var(--color-primary);
  }
  .grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: 2rem;
  }
  .card {
    padding: 1.5rem;
    transition: transform 0.2s ease;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 20px rgba(0, 219, 233, 0.2);
  }
  .partners-placeholder {
    padding: 2rem;
    border: 1px dashed var(--color-outline);
    text-align: center;
    border-radius: var(--radius-sm);
  }
</style>
