---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Sparkles from "../components/Sparkles.astro";
---

<BaseLayout
  title="Inicio | NERDS"
  description="NERDS - Núcleo Especializado em Reengenharia e Desenvolvimento de Software."
>
  <!-- Hero Section -->
  <section class="hero" style="position: relative;">
    <Sparkles particleCount={150} minSize={0.5} maxSize={2} />
    <h1 data-scramble>Núcleo <span class="glow">NERDS</span></h1>
    <p class="mono">> Núcleo Especializado em Reengenharia e Desenvolvimento de Software.</p>
  </section>

  <!-- Highlights Section -->
  <section class="bento-section">
    <SectionTitle title="Destaques" subtitle="Iniciativas em evidência no portal" />
    <div class="bento-grid">
      <a href="/projetos" class="bento-card glass interactive projects-card">
        <div class="bento-content">
          <h3 class="mono" data-scramble>PROJETOS_</h3>
          <p>Ações contínuas de impacto social e reengenharia técnica.</p>
        </div>
        <span class="arrow mono">> EXPLORAR</span>
      </a>
      
      <a href="/cursos" class="bento-card glass interactive courses-card">
        <div class="bento-content">
          <h3 class="mono" data-scramble>CURSOS_</h3>
          <p>Capacitação e formação para a comunidade acadêmica.</p>
        </div>
        <span class="arrow mono">> EXPLORAR</span>
      </a>

      <a href="/noticias-eventos" class="bento-card glass interactive news-card">
        <div class="bento-content">
          <h3 class="mono" data-scramble>NOTICIAS_</h3>
          <p>Últimos eventos e atualizações do núcleo.</p>
        </div>
        <span class="arrow mono">> EXPLORAR</span>
      </a>

      <div class="bento-card glass info-card">
        <div class="bento-content">
          <h3 class="mono" style="color: var(--color-secondary);">CORE_STATE</h3>
          <ul class="stats-list mono">
            <li>CONNECTED: TRUE</li>
            <li>NODES: 42</li>
            <li>SIGNAL: STABLE</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Participation Section -->
  <section class="glass participation-card">
    <SectionTitle title="Como Participar" />
    <p>
      Fique atento aos editais abertos e inscreva-se nas nossas atividades. O NERDS é o espaço
      de troca entre a reengenharia de software e as demandas da comunidade.
    </p>
    <div style="margin-top: 2rem;">
      <a href="/noticias-eventos" class="cta-btn mono">VER_EDITAIS_ABERTOS</a>
    </div>
  </section>

  <!-- Impact Metrics Section -->
  <section style="margin-top: 4rem;">
    <SectionTitle title="Impacto em Dados" subtitle="Métricas de nossa atuação acadêmica" />
    <div class="metrics-grid">
      <div class="metric-item glass">
        <span class="metric-value mono">15+</span>
        <span class="metric-label mono">PROJETOS_ATIVOS</span>
      </div>
      <div class="metric-item glass">
        <span class="metric-value mono">1.2k</span>
        <span class="metric-label mono">ALUNOS_IMPACTADOS</span>
      </div>
      <div class="metric-item glass">
        <span class="metric-value mono">45</span>
        <span class="metric-label mono">PARCEIROS_REDE</span>
      </div>
      <div class="metric-item glass">
        <span class="metric-value mono">100%</span>
        <span class="metric-label mono">OPEN_ACCESS</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 6rem 0;
    text-align: center;
  }
  .hero-logo {
    width: 80px;
    height: 80px;
    margin-bottom: 2rem;
    filter: drop-shadow(0 0 20px rgba(0, 219, 233, 0.4));
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  h1 {
    font-size: 3.5rem;
    margin: 0;
    position: relative;
    z-index: 1;
  }
  .glow {
    text-shadow: 0 0 15px var(--color-primary);
  }
  .hero p {
    position: relative;
    z-index: 1;
  }
  /* Bento Grid Styles */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, minmax(220px, auto));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .bento-card {
    padding: 1.5rem;
    text-decoration: none;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .projects-card { grid-column: span 2; grid-row: span 2; }
  .courses-card { grid-column: span 2; grid-row: span 1; }
  .news-card { grid-column: span 1; grid-row: span 1; }
  .info-card { grid-column: span 1; grid-row: span 1; }

  .bento-content h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .bento-content p { font-size: 0.9rem; opacity: 0.7; }

  .stats-list {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    font-size: 0.65rem;
    color: var(--color-secondary);
    opacity: 0.8;
  }

  @media (max-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto;
    }
    .projects-card, .courses-card, .news-card, .info-card {
      grid-column: span 2;
    }
  }
  .arrow {
    display: block;
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--color-primary);
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }
  .card:hover .arrow {
    opacity: 1;
  }

  .participation-card {
    margin-top: 4rem; 
    padding: 2.5rem; 
    border-left: 4px solid var(--color-secondary);
  }

  .cta-btn {
    display: inline-block;
    padding: 1rem 2rem;
    border: 1px solid var(--color-secondary);
    color: var(--color-secondary);
    text-decoration: none;
    font-weight: bold;
    letter-spacing: 0.1em;
    transition: all 0.3s ease;
  }
  .cta-btn:hover {
    background: var(--color-secondary);
    color: var(--color-bg);
    box-shadow: 0 0 15px var(--color-secondary);
  }

  /* Metrics Styling */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .metric-item {
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.3s ease;
  }
  .metric-item:hover {
    border-bottom-color: var(--color-primary);
  }
  .metric-value {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    text-shadow: 0 0 10px rgba(0, 219, 233, 0.3);
  }
  .metric-label {
    font-size: 0.7rem;
    color: var(--color-secondary);
    opacity: 0.8;
    letter-spacing: 0.05em;
  }
</style>
