---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  const projetos = await getCollection("projetos");
  return projetos.map((p) => ({
    params: { slug: p.id },
  }));
}

const { slug } = Astro.params;
const p = await getEntry("projetos", slug);

if (!p) return Astro.redirect("/404");
---

<BaseLayout title={`${p.data.titulo} | Projetos`} description={p.data.resumo}>
  <article>
    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 1rem;">
      <a href="/projetos" class="mono" style="color: var(--color-secondary); text-decoration: none; font-size: 0.8rem;">
        &lt; VOLTAR PARA LISTAGEM
      </a>
      <span class="mono" style="font-size: 0.8rem; opacity: 0.3;">/</span>
      <span class="mono" style="font-size: 0.8rem; opacity: 0.5;">DETALHES DO PROJETO</span>
    </div>

    <SectionTitle title={p.data.titulo} subtitle={`Área: ${p.data.area} | Início em ${p.data.dataInicio}`} />

    <div class="grid" style="display: grid; gap: 2rem; margin-top: 2rem;">
      <div class="glass" style="padding: 2rem;">
        <h3 class="mono" style="color: var(--color-primary);">RESUMO EXECUTIVO</h3>
        <p style="line-height: 1.8; margin-top: 1rem;">{p.data.descricao}</p>
      </div>

      <aside class="glass" style="padding: 2rem; height: fit-content;">
        <h3 class="mono" style="color: var(--color-primary);">STATUS DO SISTEMA</h3>
        <div style="margin-top: 1.5rem;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
            <span class="mono" style="font-size: 0.8rem;">DISPONIBILIDADE:</span>
            <span class="mono" style="font-size: 0.8rem; color: var(--color-secondary);">ONLINE</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span class="mono" style="font-size: 0.8rem;">FASE ATUAL:</span>
            <span class="mono" style="font-size: 0.8rem; color: var(--color-primary);">{p.data.status.toUpperCase()}</span>
          </div>
        </div>
        <button class="cta-btn mono" style="width: 100%; margin-top: 2rem;">SOLICITAR PARTICIPAÇÃO</button>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .grid { grid-template-columns: 2fr 1fr; }
  @media (max-width: 768px) {
    .grid { grid-template-columns: 1fr; }
  }
  .cta-btn {
    background: var(--color-primary);
    color: var(--color-bg);
    border: none;
    padding: 1rem;
    font-weight: bold;
    cursor: pointer;
    border-radius: var(--radius-sm);
  }
  .cta-btn:hover {
    box-shadow: 0 0 15px var(--color-primary);
  }
</style>
